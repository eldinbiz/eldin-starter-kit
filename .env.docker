# ===== Docker Environment Variables =====
# Copy this file to .env and customize for your Docker setup
# Usage: cp .env.docker .env

APP_NAME="Scaffolding App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ===== Database (MariaDB via Docker) =====
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
# Root password used when MariaDB container initializes
DB_ROOT_PASSWORD=rootpassword

# ===== Queue & Cache (Database Driver) =====
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# ===== Docker Control =====
# Set to "true" to auto-run migrations on container start (dev only)
AUTO_MIGRATE=true

# ===== Mail =====
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Vite (Dev) =====
VITE_APP_NAME="${APP_NAME}"

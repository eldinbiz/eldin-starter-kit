#!/bin/sh
set -o pipefail

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
RUN_NAME="browser_test_${TIMESTAMP}"
PEST_LOG=".pest/${RUN_NAME}.log"
RESULTS_DIR="browser-test-results"
RUN_SNAPSHOT_DIR="${RESULTS_DIR}/${RUN_NAME}"
RUN_RESULTS_LOG="${RESULTS_DIR}/${RUN_NAME}.log"

mkdir -p .pest
mkdir -p "$RESULTS_DIR"
mkdir -p "$RUN_SNAPSHOT_DIR"

export BROWSER_SNAPSHOT_DIR="${RUN_SNAPSHOT_DIR}"

if [ -x "/usr/bin/chromium-browser" ]; then
    export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium-browser"
    export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
    for shell_bin in /root/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell /root/.cache/ms-playwright/chromium-*/chrome-linux64/chrome; do
        if [ -e "$shell_bin" ] && [ ! -L "$shell_bin" ]; then
            rm -f "$shell_bin"
            ln -s /usr/bin/chromium-browser "$shell_bin"
        fi
    done
elif [ -x "/usr/bin/chromium" ]; then
    export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium"
    export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
fi

HOT_RESTORE=0
if [ -f "public/hot" ]; then
    mv public/hot public/hot.test-backup
    HOT_RESTORE=1
fi

restore_hot() {
    if [ "$HOT_RESTORE" -eq 1 ] && [ -f "public/hot.test-backup" ]; then
        mv public/hot.test-backup public/hot
    fi
}
trap restore_hot EXIT INT TERM

rm -rf vendor/pestphp/pest-plugin-browser/.temp
rm -rf tests/Browser/Screenshots/*
php artisan config:clear
php artisan view:clear

if [ $# -gt 0 ] && [ -e "$1" ]; then
    TARGET="$1"
    shift
    php -d memory_limit=1024M -d output_buffering=0 vendor/pestphp/pest/bin/pest "$TARGET" --colors=always "$@" 2>&1 | tee "$PEST_LOG" "$RUN_RESULTS_LOG"
    TEST_EXIT_CODE=$?
else
    php -d memory_limit=1024M -d output_buffering=0 vendor/pestphp/pest/bin/pest tests/Browser --colors=always "$@" 2>&1 | tee "$PEST_LOG" "$RUN_RESULTS_LOG"
    TEST_EXIT_CODE=$?
fi

restore_hot

if [ -d "tests/Browser/Screenshots" ] && [ "$(ls -A tests/Browser/Screenshots 2>/dev/null)" ]; then
    cp -rn tests/Browser/Screenshots/* "$RUN_SNAPSHOT_DIR/" 2>/dev/null || true
fi

if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "================================================================="
    echo "Browser test failure detected (exit code: $TEST_EXIT_CODE)."
    echo "Cleaning up snapshot directory: ${RUN_SNAPSHOT_DIR}"
    echo "Logs preserved: ${PEST_LOG} and ${RUN_RESULTS_LOG}"
    echo "================================================================="
    rm -rf "$RUN_SNAPSHOT_DIR"
    exit $TEST_EXIT_CODE
else
    echo ""
    echo "================================================================="
    echo "All browser tests passed successfully!"
    echo "Snapshots preserved in: ${RUN_SNAPSHOT_DIR}"
    echo "Logs saved in: ${PEST_LOG} and ${RUN_RESULTS_LOG}"
    echo "================================================================="
    exit 0
fi

